Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 617
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: OptimizedMap (loop-closure corrected)
      Topic:
        Value: /loop_closure/optimized_map
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.03
      Color: 0; 255; 127
      Color Transformer: FlatColor
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: OptimizedPath
      Topic:
        Value: /loop_closure/optimized_path
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
      Color: 255; 0; 0
      Line Style: Lines
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RawCurrentScan (FAST-LIO, uncorrected)
      Topic:
        Value: /cloud_registered
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
      Style: Flat Squares
      Size (m): 0.03
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.9
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 60
