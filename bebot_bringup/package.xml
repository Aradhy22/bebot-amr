<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bebot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files to bring up the bebot skid-steer AMR simulation</description>
  <maintainer email="aradhyagarwal242@gmail.com">bebot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>bebot_gazebo</exec_depend>
  <exec_depend>bebot_slam</exec_depend>
  <exec_depend>bebot_odom</exec_depend>
  <exec_depend>bebot_navigation</exec_depend>
  <exec_depend>bebot_vision</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
